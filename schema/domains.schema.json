{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-skill-tracker/schema/domains.schema.json",
  "title": "DomainsFile",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/domain" }
    }
  },
  "required": ["schemaVersion", "domains"],
  "additionalProperties": false,
  "$defs": {
    "domain": {
      "type": "object",
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/domainId" },
        "title": { "type": "string", "minLength": 1 },
        "blurb": { "type": "string", "minLength": 1 },
        "palette": { "$ref": "./common.schema.json#/$defs/palette" },
        "subregions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subregion" }
        }
      },
      "required": ["id", "title", "blurb", "palette"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "making" } }, "required": ["id"] },
          "then": { "required": ["subregions"] }
        },
        {
          "if": { "properties": { "id": { "not": { "const": "making" } } }, "required": ["id"] },
          "then": { "properties": { "subregions": false } }
        }
      ]
    },
    "subregion": {
      "type": "object",
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/subregionId" },
        "title": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "title"],
      "additionalProperties": false
    }
  }
}
