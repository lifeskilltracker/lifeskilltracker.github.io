{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-skill-tracker/schema/manifest.schema.json",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generated": { "type": "string", "format": "date-time" },
    "taxonomy": { "$ref": "#/$defs/taxonomy" },
    "trees": {
      "type": "array",
      "items": { "$ref": "#/$defs/treeEntry" }
    },
    "moved": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "uid → destination tree id for every op:moved entry (§7.2)."
    }
  },
  "required": ["schemaVersion", "generated", "taxonomy", "trees", "moved"],
  "additionalProperties": false,
  "$defs": {
    "compiledDomain": {
      "type": "object",
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/domainId" },
        "title": { "type": "string", "minLength": 1 },
        "blurb": { "type": "string", "minLength": 1 },
        "palette": { "$ref": "./common.schema.json#/$defs/palette" },
        "subregions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "./common.schema.json#/$defs/subregionId" },
              "title": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "title"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "title", "blurb", "palette"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "making" } }, "required": ["id"] },
          "then": { "required": ["subregions"] }
        },
        {
          "if": { "properties": { "id": { "not": { "const": "making" } } }, "required": ["id"] },
          "then": { "properties": { "subregions": false } }
        }
      ]
    },
    "compiledFacet": {
      "type": "object",
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "required": ["id", "title"],
      "additionalProperties": false
    },
    "compiledMapRegion": {
      "type": "object",
      "properties": {
        "domain": { "$ref": "./common.schema.json#/$defs/domainId" },
        "path": { "type": "string", "minLength": 1 },
        "label": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        },
        "bounds": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false
        },
        "subregions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "./common.schema.json#/$defs/subregionId" },
              "path": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "path"],
            "additionalProperties": false
          }
        }
      },
      "required": ["domain", "path"],
      "additionalProperties": false
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "domains": {
          "type": "array",
          "items": { "$ref": "#/$defs/compiledDomain" }
        },
        "facets": {
          "type": "array",
          "items": { "$ref": "#/$defs/compiledFacet" }
        },
        "map": {
          "type": "object",
          "properties": {
            "regions": {
              "type": "array",
              "items": { "$ref": "#/$defs/compiledMapRegion" }
            }
          },
          "required": ["regions"],
          "additionalProperties": false
        }
      },
      "required": ["domains", "facets", "map"],
      "additionalProperties": false
    },
    "treeEntry": {
      "type": "object",
      "properties": {
        "id": { "$ref": "./common.schema.json#/$defs/slug" },
        "contentVersion": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "./common.schema.json#/$defs/domainId" },
        "secondaryDomains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "subregion": { "$ref": "./common.schema.json#/$defs/subregionId" },
        "facets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "archetype": { "$ref": "./common.schema.json#/$defs/archetype" },
        "milestoneCount": { "type": "integer", "minimum": 0 },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "bundle": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "contentVersion", "title", "summary", "domain", "milestoneCount", "authors", "bundle"],
      "additionalProperties": false
    }
  }
}
