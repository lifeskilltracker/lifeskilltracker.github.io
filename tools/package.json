{
  "name": "@life-skill-tracker/tools",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "bin": {
    "lst": "./dist/cli.js"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.json",
    "compile": "npm run build:cli && node dist/cli.js compile",
    "prepare": "npm run build:cli",
    "gen:types": "node dist/gen-types.js",
    "test": "npm run build:cli && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "14.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "11.9.3",
    "@types/node": "20.19.43",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
